# ==========================================
# ISMAIL AI - Environment Variables
# Version: 1.0.0
# ==========================================

# 1. Google Gemini API (Required for AI Orchestrator & 12 Specialist Agents)
# Automatically injected in AI Studio. When deploying to Render or VPS, get your key from Google AI Studio.
GEMINI_API_KEY="AIzaSy..."

# 2. Telegram Bot Configuration (grammY)
# Create a bot via @BotFather on Telegram to obtain the token.
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Telegram Owner ID (Security: Only this Telegram User ID can execute commands & receive approvals)
# Send /start or message to @userinfobot on Telegram to find your Telegram User ID.
TELEGRAM_OWNER_ID="123456789"

# 3. Supabase PostgreSQL Configuration (Database, RLS, Vector Search)
# Found in your Supabase project dashboard -> Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
# Service Role Key is used server-side only for admin operations and orchestrator state
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# 4. App & Deployment URL
# Used for Telegram webhook callbacks, OAuth redirects, and self-referential links
APP_URL="https://ismail-ai.onrender.com"
PORT=3000
NODE_ENV="development"

# 5. Optional External Integrations (Activated when credentials provided)
GOOGLE_WORKSPACE_CLIENT_ID=""
GOOGLE_WORKSPACE_CLIENT_SECRET=""
META_GRAPH_ACCESS_TOKEN=""
